      _Str_view _S_all()
      { return ::std::__format::_Widen<_CharT>("[]{}(), : ", L"[]{}(), : "); }

      static consteval
      _Str_view _S_squares()
      { return _S_all().substr(0, 2); }

      static consteval
      _Str_view _S_braces()
      { return _S_all().substr(2, 2); }

