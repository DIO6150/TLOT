     << " | BearingY: " << glyph.bearingY
     << " | Advance: " << glyph.advance << std::endl;
    }

    if (bitmap.buffer) {
     glyph.bitmap.assign(bitmap.buffer, bitmap.buffer + (bitmap.width * bitmap.rows));
    }

    m_glyphs[size].emplace(c, glyph);
   }

