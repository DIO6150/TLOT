      static consteval
      _Str_view _S_all()
      { return ::std::__format::_Widen<_CharT>("\t\\t\n\\n\r\\r\\\\\\\"\\\"'\\'\\u\\x", L"\t\\t\n\\n\r\\r\\\\\\\"\\\"'\\'\\u\\x"); }

