     continue;
    }

    FT_Bitmap bitmap = m_face->glyph->bitmap;

    Glyph glyph;
    glyph.width = bitmap.width;
    glyph.height = bitmap.rows;
    glyph.bearingX = m_face->glyph->bitmap_left;
