uint32_t SceneInspector::GetOpenGLTexture (ResourceHandle handle, Texture const & texture)
{
 if (m_textures.find (handle) != m_textures.end ()) return m_textures[handle];

 uint32_t obj;

 glad_glActiveTexture(0x84C0);
 glad_glGenTextures (1, &obj);

 glad_glBindTexture (0x0DE1, obj);

 glad_glTexParameteri(0x0DE1, 0x2801, 0x2600);
 glad_glTexParameteri(0x0DE1, 0x2800, 0x2600);
 glad_glTexParameteri(0x0DE1, 0x2802, 0x812F);
 glad_glTexParameteri(0x0DE1, 0x2803, 0x812F);

 glad_glTexImage2D (0x0DE1, 0, 0x8058, texture.width, texture.height, 0, 0x1908, 0x1401, texture.data);
 glad_glGenerateMipmap (0x0DE1);

 m_textures[handle] = obj;

 return obj;
}
